generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  PKL
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) // Wajib untuk Better Auth
  username      String?   @unique // Ini yang tadi hilang!
  image         String?
  role          Role      @default(STAFF)
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  permissions UserPermission?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model UserPermission {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  canCreate Boolean @default(false) @map("can_create")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")
  canPrint  Boolean @default(false) @map("can_print")
  canTrack  Boolean @default(false) @map("can_track")

  @@map("user_permissions")
}

model Department {
  id        String  @id @default(cuid())
  shortName String  @unique @map("short_name")
  fullName  String  @default("")
  isActive  Boolean @default(true) @map("is_active")

  registerSurat RegisterSurat[]
  registerPI    RegisterPI[]
  nomorCounter  NomorCounter?

  @@map("departments")
}

model RegisterSurat {
  id            Int        @id @default(autoincrement())
  nomor         String
  deptId        String     @map("dept_id")
  dept          Department @relation(fields: [deptId], references: [id])
  tanggalTerima DateTime   @map("tanggal_terima")
  asalSurat     String     @map("asal_surat")
  tujuan        String     @default("")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  detailSurat DetailSurat[]

  @@map("register_surat")
}

model RegisterPI {
  id            Int        @id @default(autoincrement())
  nomor         String
  deptId        String     @map("dept_id")
  dept          Department @relation(fields: [deptId], references: [id])
  tanggalTerima DateTime   @map("tanggal_terima")
  asalSurat     String     @map("asal_surat")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  detailPI DetailPI[]

  @@map("register_pi")
}

model DetailPI {
  id           Int        @id @default(autoincrement())
  registerId   Int        @map("register_id")
  register     RegisterPI @relation(fields: [registerId], references: [id], onDelete: Cascade)
  namaSupplier String     @map("nama_supplier")
  noInvoice    String?    @map("no_invoice")
  nomorSurat   String?    @map("nomor_surat")
  tanggalSurat DateTime   @map("tanggal_surat")
  tujuan       String?
  cc           String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("detail_pi")
}

model DetailSurat {
  id           Int           @id @default(autoincrement())
  registerId   Int           @map("register_id")
  register     RegisterSurat @relation(fields: [registerId], references: [id], onDelete: Cascade)
  perihal      String
  noSurat      String?       @map("no_surat")
  lampiran     String?
  tanggalSurat DateTime      @map("tanggal_surat")
  tujuan       String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("detail_surat")
}

model NomorCounter {
  deptId  String     @id @map("dept_id")
  dept    Department @relation(fields: [deptId], references: [id])
  counter Int        @default(0)

  @@map("nomor_counter")
}
