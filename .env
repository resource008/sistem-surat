# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789
POSTGRES_DB=sistem_surat
DB_HOST_PORT=5432

# ─── App ─────────────────────────────────────────────────────
APP_PORT=3001
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ─── Prisma ──────────────────────────────────────────────────
# Pakai hostname "db" karena app dan db dalam satu Docker network
DATABASE_URL=postgresql://postgres:123456789@db:5432/sistem_surat

# ─── Auth ────────────────────────────────────────────────────
BETTER_AUTH_SECRET=dev-secret-change-before-production-123456
BETTER_AUTH_URL=http://localhost:3001

# ─── Dev flags ───────────────────────────────────────────────
SEED_ON_START=true
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
