POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sistem_surat

# Untuk app di dalam Docker, host database adalah "db".
DATABASE_URL="postgresql://postgres:password@db:5432/sistem_surat"

# Kalau menjalankan app di host/laptop tanpa Docker, gunakan ini:
# DATABASE_URL="postgresql://postgres:password@localhost:5433/sistem_surat"

BETTER_AUTH_SECRET="ganti-dengan-secret-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3001"

# Set ke true kalau ingin seed otomatis setiap container app start.
SEED_ON_START=false
