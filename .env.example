# Salin file ini menjadi .env lalu isi nilainya.

# Keterangan:
# - docker-compose.yml otomatis memakai host database internal bernama "db".
# - Jika menjalankan Prisma dari komputer host, pakai localhost seperti contoh DATABASE_URL di bawah.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sistem_surat
DB_HOST_PORT=5432

# App
APP_PORT=3001
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Prisma untuk command dari host/laptop
DATABASE_URL=postgresql://postgres:password@localhost:5432/sistem_surat

# Auth
BETTER_AUTH_SECRET=<masukkan_auth_secret_dari_better_auth>
BETTER_AUTH_URL=http://localhost:3001
# Tambahkan origin cloud jika berbeda dari BETTER_AUTH_URL, pisahkan dengan koma.
# Contoh: BETTER_AUTH_TRUSTED_ORIGINS=http://103.191.92.244
BETTER_AUTH_TRUSTED_ORIGINS=
