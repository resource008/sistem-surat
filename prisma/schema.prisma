generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  PKL
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) // Wajib untuk Better Auth
  username      String?   @unique        // Ini yang tadi hilang!
  image         String?
  role          Role      @default(STAFF)
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]
  permissions   UserPermission?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model UserPermission {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  canCreate Boolean @default(false) @map("can_create")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")
  canPrint  Boolean @default(false) @map("can_print")
  canTrack  Boolean @default(false) @map("can_track")

  @@map("user_permissions")
}

model Department {
  id             String          @id
  shortName      String          @map("short_name")
  tujuan         String          @default("")
  printSheetName String         @default("") @map("print_column_name")
  isActive       Boolean         @default(true) @map("is_active")

  registerSurat  RegisterSurat[]
  nomorCounter   NomorCounter?
  columns        DepartmentColumn[]

  @@map("departments")
}

model DepartmentColumn {
  id               String     @id
  departmentId     String     @map("department_id")
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  label            String
  dataType         String     @map("data_type")
  defaultValue     String     @default("") @map("default_value")
  isDefault        Boolean    @default(false) @map("is_default")
  isRequired       Boolean    @default(false) @map("is_required")
  showInDataSurat  Boolean    @default(false) @map("show_in_data_surat")
  showInPrint      Boolean    @default(true) @map("show_in_print")
  sortOrder        Int        @default(0) @map("sort_order")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("department_columns")
}

model RegisterSurat {
  id            Int           @id @default(autoincrement())
  nomor         String
  deptId        String        @map("dept_id")
  dept          Department    @relation(fields: [deptId], references: [id])
  tanggalTerima DateTime      @map("tanggal_terima")
  asalSurat     String        @map("asal_surat")
  tujuan        String        @default("")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  detailSurat   DetailSurat[]

  @@map("register_surat")
}

model DetailSurat {
  id              Int            @id @default(autoincrement())
  registerId      Int            @map("register_id")
  register        RegisterSurat  @relation(fields: [registerId], references: [id], onDelete: Cascade)
  perihal         String
  noSurat         String?        @map("no_surat")
  lampiran        String?
  tanggalSurat    DateTime       @map("tanggal_surat")
  tujuan          String?
  customFields    Json           @default("{}") @map("custom_fields")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("detail_surat")
}

model NomorCounter {
  deptId  String     @id @map("dept_id")
  dept    Department @relation(fields: [deptId], references: [id])
  counter Int        @default(0)

  @@map("nomor_counter")
}

model TrackSheet {
  id          String       @id
  name        String
  description String       @default("")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  hiddenAt    DateTime?    @map("hidden_at")
  categories  TrackCategory[]
  fields      TrackField[]

  @@map("track_sheets")
}

model TrackCategory {
  id        String     @id
  sheetId   String     @map("sheet_id")
  sheet     TrackSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  name      String
  color     String     @default("#2563eb")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([sheetId])
  @@map("track_categories")
}

model TrackField {
  id         String     @id
  sheetId    String     @map("sheet_id")
  sheet      TrackSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  categoryId String?    @map("category_id")
  category   String
  categoryColor String  @default("#2563eb") @map("category_color")
  region     String
  columnName String     @map("column_name")
  dataType   String     @map("data_type")
  defaultValue String   @default("") @map("default_value")
  categoryOptions String @default("[]") @map("category_options")
  sortOrder  Int        @default(0) @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([sheetId])
  @@map("track_fields")
}

